# Explicit local demo. Uses .data/demo.json; no LLM is called.
APP_MODE=demo
PORT=3001
HOST=127.0.0.1

# Set APP_MODE=supabase to require real sign-in and database storage.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional in Supabase mode: n8n qualification workflow.
# Start/publish the supplied workflow, configure its Header Auth credential.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# A random 32+ character secret, never exposed to the browser or model.
AGENT_SIGNING_SECRET=
# API base URL reachable FROM n8n, e.g. http://host.docker.internal:3001.
API_PUBLIC_URL=http://localhost:3001
